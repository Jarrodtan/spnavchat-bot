{
  "name": "spnavchat-bot",
  "main": "src/index.js",
  "workers_dev": true,
  "compatibility_date": "2026-06-18",
  "ai": { "binding": "AI" },
  // Approved / pending / declined members, keyed by Telegram user id
  "kv_namespaces": [{ "binding": "USERS", "id": "290fe392e9cb46e49e0852b1bbff48fa" }]
  // Secrets (set with `npx wrangler secret put NAME`):
  //   BOT_TOKEN       — from @BotFather for @spnavchat_bot
  //   WEBHOOK_SECRET  — any random string; Telegram sends it back on every update
  //   LEADER_CHAT_ID  — Telegram chat id of the leaders' group that gets follow-up alerts
}
